{
  "name": "integration-huron-person",
  "version": "1.0.0",
  "description": "BU person integration via CDM api for Huron",
  "module": "dist/esm/bin/index.js",
  "main": "dist/esm/bin/index.js",
  "types": "dist/types/bin/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist/ && tsc",
    "pack": "npm run build && npm pack --pack-destination .",
    "prepack": "node bin/remove-tests.js",
    "start": "node dist/esm/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "testsilent": "jest --silent",
    "clean": "rimraf dist",
    "npm-clean": "npm cache clean --force",
    "uninstall-tgz": "npm uninstall integration-core",
    "install-tgz": "npm install --force integration-core https://simple-npm-package-bucket.s3.us-east-1.amazonaws.com/integration-core-1.0.0.tgz",
    "reinstall-tgz": "npm run uninstall-tgz && npm run install-tgz",
    "reinstall-tgz-clean": "npm run npm-clean && npm run uninstall-tgz && npm run install-tgz",
    "publish-s3": "npm run pack && aws s3 cp integration-huron-person-1.0.0.tgz s3://simple-npm-package-bucket/"
  },
  "keywords": [
    "huron",
    "integration",
    "person"
  ],
  "author": "Warren Hennemuth",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/client-secrets-manager": "^3.1014.0",
    "axios": "^1.6.2",
    "humanize-duration": "^3.33.1",
    "integration-core": "file:../integration-core",
    "jsonwebtoken": "^9.0.2",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/stream-json": "^1.7.8",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "overrides": {
    "tar": "^7.5.6"
  }
}
